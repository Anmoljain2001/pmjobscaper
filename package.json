{
  "name": "pm-job-radar",
  "version": "1.0.0",
  "description": "Collects product management job posts from LinkedIn and WhatsApp groups into a local triage dashboard.",
  "type": "module",
  "main": "src/index.js",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --no-warnings src/index.js",
    "seed": "node --no-warnings scripts/seed.js",
    "test": "node --no-warnings scripts/test-classifier.js && node --no-warnings scripts/test-parsers.js"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "imapflow": "^1.0.171",
    "mailparser": "^3.7.2",
    "node-cron": "^3.0.3",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "optionalDependencies": {
    "whatsapp-web.js": "^1.26.0"
  }
