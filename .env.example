# ---------- General ----------
PORT=3000
# Comma-separated role keywords. A post must match at least one to be kept.
ROLE_KEYWORDS=product manager,product management,associate product manager,apm,senior product manager,group product manager,product owner,product lead,head of product,principal product manager
# Minimum score (0-100) a post needs to land in the dashboard
MIN_SCORE=40

# ---------- About you (used to draft messages) ----------
MY_NAME=Your Name
MY_HEADLINE=Product Manager, 4 yrs in B2B SaaS
MY_PITCH=I've shipped onboarding and pricing features that lifted activation 18%. Looking for PM roles in fintech or SaaS.
RESUME_URL=https://example.com/my-resume.pdf
LINKEDIN_PROFILE_URL=https://www.linkedin.com/in/your-handle

# ---------- Claude (optional, improves parsing and message drafts) ----------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# ---------- WhatsApp ----------
WHATSAPP_ENABLED=true
# Exact group names to watch, separated by |   Leave empty to watch every group you are in.
WHATSAPP_GROUPS=PM Jobs India|Product Folks Hiring
# How many recent messages per group to scan on first connect
WHATSAPP_BACKFILL=150
# Safety limits for messages you send from the dashboard
WHATSAPP_MIN_GAP_SECONDS=90
WHATSAPP_DAILY_LIMIT=15

# ---------- LinkedIn via job-alert emails (recommended) ----------
# Create LinkedIn job alerts for "Product Manager", then point this at the inbox that receives them.
# Gmail: turn on 2-step verification and create an App Password.
IMAP_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@gmail.com
IMAP_PASS=your-16-char-app-password
IMAP_LOOKBACK_DAYS=7

# ---------- LinkedIn public job search (opt-in) ----------
# Reads LinkedIn's logged-out job search pages. This goes against LinkedIn's terms of use;
# keep it off unless you accept that. Format: keywords@location, separated by |
LINKEDIN_PUBLIC_ENABLED=false
LINKEDIN_SEARCHES=Product Manager@India|Associate Product Manager@Bengaluru
# How often to check, in hours
LINKEDIN_PUBLIC_EVERY_HOURS=6
